// StableSound settings dialog.
//
// A real Win32 dialog template, compiled by rc.exe and embedded in the exe.
// CLAUDE.md forbids a drawn-UI toolkit: the primary user is blind and uses
// JAWS, and a template gives genuine EDIT, COMBOBOX and BUTTON controls with
// the tab order, mnemonics, default button and Escape handling that Windows
// provides for free and that a screen reader already knows how to read.
//
// Three layout rules matter for the screen reader, and all three are
// load-bearing:
//
//   1. Every label comes immediately before the control it names. Tab order
//      is template order, and a static label is announced as the name of the
//      control that follows it. Reordering these silently breaks the reading.
//   2. Every mnemonic is unique within the dialog. A mnemonic on a static
//      label moves focus to the next control that can take it, which is what
//      makes Alt+O reach the device list.
//   3. Every control reads correctly on its own, without its group name. A
//      screen reader user hears one control at a time: the Milestone 4 round
//      reported "let go of them" as meaningless heard in isolation, because
//      "them" lived in a group heading three controls earlier. No label here
//      depends on another to make sense.
//
// Rule 3 is the one that carries the weight, because **there is no way from
// in here to make JAWS announce the group headings.** The same round asked
// for that, and the obvious lever turned out to be already pulled: WS_GROUP
// on the first control of each group, which rc.exe adds to every LTEXT by
// default, so it was present all along and announced nothing. What JAWS
// actually uses is geometry - the GROUPBOX rectangle enclosing the focused
// control - and that has always been true here too (checked by reading the
// live control rectangles out of the running dialog). Whether it speaks them
// is JAWS' own verbosity setting, not ours. So the headings are kept for the
// sighted reader and for structure, and nothing is allowed to depend on them.
//
// Mnemonics in use: O S L A K P V H U T W D I E F X. OK and Cancel
// deliberately have none - they are the default and cancel buttons, reached
// with Enter and Escape. IDD_MESSAGE has its own namespace and reuses W.
//
// The three added in Milestone 6 had to work around the letters already
// taken: Help is H&elp because H is the toggle hotkey's, Open the log &file
// because L is "Let go of the headphones", and E&xit because X was free and
// matches the tray menu's wording.

#include <windows.h>

// The application manifest. It is here rather than in a crate of its own
// because rc.exe is already running over this file, so it costs no dependency
// against the size budget - and what it buys is the version 6 common
// controls, which is an accessibility matter rather than a cosmetic one. See
// stablesound.manifest.
1 RT_MANIFEST "stablesound.manifest"

// The version resource. Windows shows this on the Properties page of the exe,
// and it is the only place a downloaded copy can say what it is: there is no
// installer and no About box. Keep the four numbers in step with the version
// in Cargo.toml - nothing checks that they agree.
//
// The strings are the ones Explorer actually reads. CompanyName is left as
// the author rather than invented, and OriginalFilename matters if the file
// is ever renamed: it is what the exe says it was built as.
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "Laurent de Fontenay"
            VALUE "FileDescription",  "Keeps Bluetooth headphones awake for screen reader speech"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "stablesound"
            VALUE "LegalCopyright",   "MIT licensed"
            VALUE "OriginalFilename", "stablesound.exe"
            VALUE "ProductName",      "StableSound"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#define IDD_SETTINGS      100
#define IDD_MESSAGE       101

#define IDC_DEVICE       1001
#define IDC_SIGNAL       1002
#define IDC_RELEASE      1003
#define IDC_TIMEOUT      1004
#define IDC_WAKE_INPUT   1005
#define IDC_EARCONS      1007
#define IDC_VOLUME       1008
#define IDC_HOTKEY       1009
#define IDC_LOGGING      1010
#define IDC_DIAGNOSTICS  1011
#define IDC_SET_HOTKEY   1012
#define IDC_STARTUP      1013
#define IDC_USE_SET_HOTKEY 1014
#define IDC_MESSAGE      1015
#define IDC_MESSAGE_LABEL 1016
// Not IDC_HELP: windows.h already has that, as the standard help cursor.
#define IDC_OPEN_HELP    1017
#define IDC_OPEN_LOG     1018
#define IDC_EXIT         1019

IDD_SETTINGS DIALOGEX 0, 0, 306, 412
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "StableSound Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Keeping the headphones awake", -1, 7, 7, 292, 88

    LTEXT           "&Output device to keep awake:", -1, 14, 22, 108, 8
    COMBOBOX        IDC_DEVICE, 126, 20, 166, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP

    LTEXT           "Keep-alive &signal to send it:", -1, 14, 40, 108, 8
    COMBOBOX        IDC_SIGNAL, 126, 38, 166, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "&Let go of the headphones:", -1, 14, 58, 108, 8
    COMBOBOX        IDC_RELEASE, 126, 56, 166, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Let go &after this many seconds:", -1, 14, 76, 108, 8
    EDITTEXT        IDC_TIMEOUT, 126, 74, 48, 12, ES_NUMBER | WS_TABSTOP

    GROUPBOX        "Waking up again", -1, 7, 99, 292, 32
    CONTROL         "Start keep-alive again when I use the &keyboard",
                    IDC_WAKE_INPUT, "Button",
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 14, 114, 278, 10

    GROUPBOX        "Tones", -1, 7, 135, 292, 52
    CONTROL         "&Play a tone when I switch keep-alive on or off",
                    IDC_EARCONS, "Button",
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 14, 150, 278, 10
    LTEXT           "Tone &volume (percent):", -1, 14, 168, 108, 8
    EDITTEXT        IDC_VOLUME, 126, 166, 48, 12, ES_NUMBER | WS_TABSTOP

    GROUPBOX        "Hotkeys", -1, 7, 191, 292, 86
    LTEXT           "&Hotkey to switch keep-alive on and off:", -1, 14, 206, 138, 8
    EDITTEXT        IDC_HOTKEY, 156, 204, 136, 12,
                    ES_AUTOHSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "Also &use a hotkey to open these settings",
                    IDC_USE_SET_HOTKEY, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 222, 278, 10
    LTEXT           "Hotkey to open these se&ttings:", -1, 14, 240, 138, 8
    EDITTEXT        IDC_SET_HOTKEY, 156, 238, 136, 12,
                    ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Type one or more of ctrl, alt, shift and win, then one key, joined by plus signs. For example: ctrl+win+f12",
                    -1, 14, 256, 278, 16

    GROUPBOX        "Log file", -1, 7, 281, 292, 66
    CONTROL         "&Write a log file, so a problem can be looked into later",
                    IDC_LOGGING, "Button",
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 14, 296, 278, 10
    CONTROL         "&Detailed logging, for troubleshooting",
                    IDC_DIAGNOSTICS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 312, 278, 10
    // Inside the group, immediately after the two settings it belongs to, so
    // that it is met in the place where the log is being thought about.
    PUSHBUTTON      "Open the log &file", IDC_OPEN_LOG, 14, 327, 90, 14

    GROUPBOX        "Starting up", -1, 7, 353, 292, 32
    CONTROL         "Start StableSound when I sign &in", IDC_STARTUP, "Button",
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 14, 368, 278, 10

    // Tab order is template order, and these four are deliberately not in
    // left-to-right order.
    //
    // OK and Cancel come first because they are what the dialog is normally
    // left by. Exit comes **last**, three buttons past the settings, because
    // it quits StableSound outright: tabbing one stop too far should never be
    // able to reach it. It is also placed away from OK on screen.
    DEFPUSHBUTTON   "OK", IDOK, 191, 391, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 249, 391, 50, 14
    PUSHBUTTON      "H&elp", IDC_OPEN_HELP, 7, 391, 50, 14
    PUSHBUTTON      "E&xit StableSound", IDC_EXIT, 63, 391, 80, 14
END

// What StableSound says when it cannot accept something, in place of a
// message box.
//
// The Milestone 5 round asked for this, about the advice shown when a hotkey
// is refused: "Its long, but instructive. A Jaws user needs to use the Jaws
// cursor or to virtualise the control to absorb all the detail, which may not
// be within the abilities of a more novice user. Putting the information in a
// read-only edit field would solve this, by making it possible to use the
// cursor keys to review the text."
//
// So: a read-only multi-line EDIT, which is the first tab stop and therefore
// where the focus lands. A screen reader reads it on focus exactly as a
// message box would, and then the arrow keys walk it a line or a word or a
// character at a time, with no cursor mode to switch into. Nothing else in
// the dialog competes for the focus - one button, reached by Tab, and Enter
// or Escape dismisses it from wherever you are.
//
// The label is set at runtime, and says what kind of message this is rather
// than how to read it. The round that tested this window reported the first
// wording back: JAWS said "Message, which the arrow keys will read back",
// then "read only edit" - so the label spent its words explaining something
// the control type had already said. "This already tells the user how to
// interact with the dialogue, so the message box label could rather be
// something like: 'error, and how to fix'." The kind of message was
// otherwise carried only by the ding.
//
// The text below is what a refused setting gets; `show_message` replaces it
// for anything that is not a complaint. Both wordings start with "What" so
// the W mnemonic holds whichever is showing - which is the way back to the
// text after tabbing to OK.
IDD_MESSAGE DIALOGEX 0, 0, 304, 244
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "StableSound"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&What went wrong, and how to fix it:",
                    IDC_MESSAGE_LABEL, 7, 7, 290, 8
    EDITTEXT        IDC_MESSAGE, 7, 19, 290, 198,
                    ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_GROUP |
                    WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 247, 223, 50, 14, WS_GROUP
END
